# CampusMind AI Backend Configuration
# Port for the Node.js Express API server
PORT=5000

# Optional: Google Gemini API Key
# If omitted or left empty, CampusMind AI automatically runs in its intelligent offline Demo Mode
# with comprehensive RAG answers generated from the local knowledge base.
GEMINI_API_KEY=

# Optional: Gemini model name (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
